# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
# Any characters are fine in the password. Wrap it in single quotes so Compose
# reads it literally (needed for $, #, spaces and quotes).
POSTGRES_USER=whoop
POSTGRES_PASSWORD='change-me'
POSTGRES_DB=whoop_lab

# --- WHOOP developer app (https://developer-dashboard.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Public origin served by the Cloudflare Tunnel. The OAuth redirect URL is
# ${PUBLIC_BASE_URL}/oauth/callback and the webhook URL is ${PUBLIC_BASE_URL}/webhooks/whoop.
PUBLIC_BASE_URL=https://whoop.vasumenon.com

# An experiment day is a calendar date in this zone.
LOCAL_TIMEZONE=America/New_York

# --- Experiments ---
# Local hour (0-23) from which tomorrow's arm is drawn and sent.
ASSIGN_HOUR=20
# Toggle buttons on /today, comma-separated.
TAG_KEYS=alcohol,late_meal,late_caffeine,late_screens,sick,travel,hard_training

# --- Notifications (optional). Full topic URL; leave empty to disable. ---
NTFY_URL=
NTFY_TOKEN=

# --- Host ports (loopback only). Change if something else on the server uses them. ---
API_PORT=8000
GRAFANA_PORT=3001

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD='change-me'
# Password for the read-only database role Grafana queries with (created automatically).
GRAFANA_DB_PASSWORD='change-me-too'

# --- Only for the `cloudflared` Compose profile ---
CLOUDFLARE_TUNNEL_TOKEN=

LOG_LEVEL=INFO
