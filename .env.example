# Copy to .env and fill in. Never commit .env.
# Values with $, #, spaces or quotes: wrap them in single quotes so Compose reads them literally.

# --- Passwords: set all three to long random strings (e.g. `openssl rand -hex 24`) ---
POSTGRES_PASSWORD='change-me'
GRAFANA_ADMIN_PASSWORD='change-me'
# For the read-only database role Grafana queries with (created automatically).
GRAFANA_DB_PASSWORD='change-me-too'

# --- WHOOP developer app (https://developer-dashboard.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# --- Where the app is reached ---
# Running on your own computer: leave these two as they are.
# Online behind a tunnel: PUBLIC_BASE_URL=https://whoop.example.com and delete GRAFANA_URL
# (the tunnel routes /grafana to Grafana). See the README.
# The WHOOP app's redirect URL is ${PUBLIC_BASE_URL}/oauth/callback.
PUBLIC_BASE_URL=http://localhost:8000
GRAFANA_URL=http://localhost:3001/grafana/

# An experiment day is a calendar date in this zone.
LOCAL_TIMEZONE=America/New_York

# --- Optional ---
# Phone notifications through ntfy: a full topic URL, e.g. https://ntfy.sh/<long-random-topic>.
NTFY_URL=
NTFY_TOKEN=
# Local hour (12-23) from which tomorrow's experiment arm is drawn and sent.
ASSIGN_HOUR=20
# Toggle buttons on /today, comma-separated.
TAG_KEYS=alcohol,late_meal,late_caffeine,late_screens,sick,travel,hard_training
# Host ports, bound to 127.0.0.1 only.
API_PORT=8000
GRAFANA_PORT=3001
# Folder of Bluetooth captures the worker imports (docs/band.md).
CAPTURES_DIR=./captures
# Only for the `cloudflared` Compose profile.
CLOUDFLARE_TUNNEL_TOKEN=
LOG_LEVEL=INFO
POSTGRES_USER=whoop
POSTGRES_DB=whoop_lab
