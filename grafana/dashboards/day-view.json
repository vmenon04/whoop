{
  "annotations": {
    "list": [
      {
        "name": "WHOOP workouts",
        "datasource": {
          "type": "postgres",
          "uid": "whoop-pg"
        },
        "enable": true,
        "iconColor": "orange",
        "rawQuery": "SELECT start AS time, \"end\" AS timeend, sport_name AS text FROM workouts WHERE deleted_at IS NULL AND $__timeFilter(start)",
        "target": {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-pg"
          },
          "rawSql": "SELECT start AS time, \"end\" AS timeend, sport_name AS text FROM workouts WHERE deleted_at IS NULL AND $__timeFilter(start)",
          "format": "table",
          "rawQuery": true,
          "refId": "Anno"
        }
      }
    ]
  },
  "templating": {
    "list": []
  },
  "uid": "whoop-day-view",
  "title": "Day view",
  "tags": [
    "whoop-lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "panels": [
    {
      "type": "state-timeline",
      "title": "Band state",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-pg"
          },
          "rawSql": "SELECT minute AS time, band_state AS state FROM ble_minutes WHERE minutes_version = 'ble-minutes-1' AND $__timeFilter(minute) ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "SLEEP": {
                  "color": "dark-blue",
                  "index": 0
                },
                "STILL": {
                  "color": "light-blue",
                  "index": 1
                },
                "WAKE": {
                  "color": "green",
                  "index": 2
                },
                "UP": {
                  "color": "orange",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8
      },
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Heart rate per minute (bpm): mean, min and max",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-pg"
          },
          "rawSql": "SELECT minute AS time, hr_mean AS \"mean\", hr_min AS \"min\", hr_max AS \"max\" FROM ble_minutes WHERE minutes_version = 'ble-minutes-1' AND $__timeFilter(minute) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false,
            "insertNulls": 120000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Minutes walking and running, per 15 minutes",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-pg"
          },
          "rawSql": "SELECT date_bin('15 minutes', minute, TIMESTAMPTZ '2000-01-01') AS time, sum(seconds_walk) / 60.0 AS walking, sum(seconds_run) / 60.0 AS running FROM ble_minutes WHERE minutes_version = 'ble-minutes-1' AND $__timeFilter(minute) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Steps per hour (band counter, being checked against WHOOP)",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-pg"
          },
          "rawSql": "SELECT date_trunc('hour', minute) AS time, sum(steps) AS steps FROM ble_minutes WHERE minutes_version = 'ble-minutes-1' AND $__timeFilter(minute) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Movement intensity per minute (g)",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-pg"
          },
          "rawSql": "SELECT minute AS time, accel_mean_g AS movement FROM ble_minutes WHERE minutes_version = 'ble-minutes-1' AND $__timeFilter(minute) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false,
            "insertNulls": 120000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "timeseries",
      "title": "Skin temperature per minute (C)",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-pg"
          },
          "rawSql": "SELECT minute AS time, skin_temp_c AS skin FROM ble_minutes WHERE minutes_version = 'ble-minutes-1' AND $__timeFilter(minute) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false,
            "insertNulls": 120000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      }
    }
  ]
}
