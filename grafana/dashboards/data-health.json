    {
      "type": "timeseries",
      "title": "Average heart rate per WHOOP cycle: WHOOP vs band (cycles the band covered 95%+)",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-pg"
          },
          "rawSql": "SELECT c.start AS time, 'WHOOP' AS metric, c.average_heart_rate AS value FROM cycles c WHERE c.deleted_at IS NULL AND c.score_state = 'SCORED' AND $__timeFilter(c.start) AND c.average_heart_rate IS NOT NULL AND c.\"end\" IS NOT NULL AND (SELECT sum(seconds_recorded) FROM ble_minutes WHERE minutes_version = 'ble-minutes-1' AND minute >= c.start AND minute < c.\"end\") >= 0.95 * extract(epoch FROM c.\"end\" - c.start) UNION ALL SELECT c.start AS time, 'Band' AS metric, sum(m.hr_mean * m.seconds_with_hr) / nullif(sum(m.seconds_with_hr), 0) AS value FROM cycles c JOIN ble_minutes m ON m.minutes_version = 'ble-minutes-1' AND m.minute >= c.start AND m.minute < c.\"end\" WHERE c.deleted_at IS NULL AND c.score_state = 'SCORED' AND $__timeFilter(c.start) GROUP BY c.id, c.start, c.\"end\" HAVING sum(m.seconds_recorded) >= 0.95 * extract(epoch FROM c.\"end\" - c.start) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "points",
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
