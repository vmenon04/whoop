          "rawSql": "SELECT c.start AS time, 'WHOOP' AS metric, c.step_count AS value FROM cycles c WHERE c.deleted_at IS NULL AND c.score_state = 'SCORED' AND $__timeFilter(c.start) AND c.step_count IS NOT NULL AND c.\"end\" IS NOT NULL AND (SELECT sum(seconds_recorded) FROM ble_minutes WHERE minutes_version = 'ble-minutes-1' AND minute >= c.start AND minute < c.\"end\") >= 0.95 * extract(epoch FROM c.\"end\" - c.start) UNION ALL SELECT c.start AS time, 'Band step_counter' AS metric, sum(m.steps) AS value FROM cycles c JOIN ble_minutes m ON m.minutes_version = 'ble-minutes-1' AND m.minute >= c.start AND m.minute < c.\"end\" WHERE c.deleted_at IS NULL AND c.score_state = 'SCORED' AND $__timeFilter(c.start) GROUP BY c.id, c.start, c.\"end\" HAVING sum(m.seconds_recorded) >= 0.95 * extract(epoch FROM c.\"end\" - c.start) UNION ALL SELECT c.start AS time, 'Band hw_step_counter' AS metric, sum(m.steps_hw) AS value FROM cycles c JOIN ble_minutes m ON m.minutes_version = 'ble-minutes-1' AND m.minute >= c.start AND m.minute < c.\"end\" WHERE c.deleted_at IS NULL AND c.score_state = 'SCORED' AND $__timeFilter(c.start) GROUP BY c.id, c.start, c.\"end\" HAVING sum(m.seconds_recorded) >= 0.95 * extract(epoch FROM c.\"end\" - c.start) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
