          "rawSql": "SELECT wake_date, sleep_start, sleep_end, round(rr_coverage::numeric, 3) AS rr_coverage, round(rr_corrected_share::numeric, 3) AS corrected, rr_quality_ok, round(rmssd_sleep_ms::numeric, 1) AS rmssd_sleep, round(rmssd_fixed_ms::numeric, 1) AS rmssd_02_06, round(resting_hr_median::numeric, 1) AS resting_hr, round(respiratory_rate::numeric, 1) AS resp_rate, respiratory_windows, round(spo2_mean::numeric, 1) AS spo2, round(skin_temp_mean_c::numeric, 2) AS skin_temp, decoder_version, computed_at FROM ble_nights WHERE metrics_version = 'ble-nightly-2' ORDER BY wake_date DESC LIMIT 30",
