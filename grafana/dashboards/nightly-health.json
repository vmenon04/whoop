    {
      "type": "timeseries",
      "title": "HRV, RMSSD over the night (ms). Different definitions: compare trends, not values",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-pg"
          },
          "rawSql": "SELECT (local_date + 1)::timestamp AS time, 'WHOOP' AS metric, hrv_rmssd_milli AS value FROM daily_outcomes WHERE outcome_scored AND $__timeFilter((local_date + 1)::timestamp) AND hrv_rmssd_milli IS NOT NULL UNION ALL SELECT wake_date::timestamp, 'Band (ble-nightly-2)', rmssd_sleep_ms FROM ble_nights WHERE metrics_version = 'ble-nightly-2' AND $__timeFilter(wake_date::timestamp) AND rmssd_sleep_ms IS NOT NULL ORDER BY 1",
